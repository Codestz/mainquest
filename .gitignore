# dependencies
node_modules/

# build output — all reproducible
build/
dist/
coverage/

# dist-action/ is NOT ignored, deliberately.
#
# GitHub Actions loads `runs.main` straight from the repository with no install
# step, so a JS action's bundle must be committed. Ignoring it would make the
# action fail with "file not found" for every user while working perfectly
# locally. CI checks it stays in lockstep with src/.

# third-party source, cloned on demand by `npm run icons`
vendor/

# sampling working files.
#
# The row-level sample is 400 real accounts' contribution counts. Logins are
# already stripped, and nothing in src/ reads it — the sampler writes it, and
# `data/percentiles.json` is the published result. There is no reason to
# publish other people's activity to get a distribution, so it stays local.
data/sample.anon.jsonl
build/sample.jsonl
build/logins*.txt

# local tooling state
.serena/cache/
.serena/project.local.yml
.agentry/

# python bytecode from scripts/pixelate.py
__pycache__/
*.pyc

# logs and OS noise
*.log
.DS_Store
Thumbs.db

# never commit these
.env
.env.*
*.pem
*.key
